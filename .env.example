# ---- Base de datos ----
# Neon: copiar la cadena "Connection string" (empieza con postgresql://)
# Si se deja vacío, el servidor usa SQLite local (solo para pruebas).
DATABASE_URL=

# ---- Barrera de acceso al portal (HTTP Basic) ----
PORTAL_USER=mrspets
PORTAL_PASSWORD=

# ---- Sesiones ----
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
COOKIE_SECURE=1

# ---- Primer usuario staff ----
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Cuarto de Guerra & Make.com Webhook Integration ----
WAR_ROOM_API_KEY= # Clave secreta para acceso al Cuarto de Guerra

# ---- Opcional ----
ALLOWED_ORIGIN=*
SQLITE_PATH=mrspets_local.db

# ---- Pasarela de Pagos Oficial Binance Pay (Mrs. Pets) ----
BINANCE_PAY_ENV=sandbox # 'sandbox' para pruebas | 'production' para cobro real
BINANCE_PAY_MERCHANT_ID=mrspets # Identificador de Cuenta Comercial Mrs. Pets
BINANCE_PAY_MERCHANT_EMAIL=mrspetsvzla@gmail.com # Correo de la cuenta asociada
BINANCE_PAY_API_KEY= # Certificate-SN / API Key emitida por Binance Pay Merchant Portal
BINANCE_PAY_SECRET_KEY= # Secret Key de comercio para firma HMAC-SHA512
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_CURRENCY=USDT
