# ---- Base de datos ----
# Neon: copiar la cadena "Connection string" (empieza con postgresql://)
# Si se deja vacío, el servidor usa SQLite local (solo para pruebas).
DATABASE_URL=

# ---- Barrera de acceso al portal (HTTP Basic) ----
PORTAL_USER=mrspets
PORTAL_PASSWORD=

# ---- Sesiones ----
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
COOKIE_SECURE=1

# ---- Primer usuario staff ----
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Opcional ----
ALLOWED_ORIGIN=*
SQLITE_PATH=mrspets_local.db
